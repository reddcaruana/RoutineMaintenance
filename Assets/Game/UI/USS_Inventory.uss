:root {
    font-size: 20px;
}

#InventoryWindow {
    background-color: rgba(0, 0, 0, 0.8);
    color: rgb(0, 255, 0);
    padding: 10px;
    
    position: absolute;
    top: 10px;
    left: 10px;
    width: 400px;
    height: 150px;
}

.inventory__item {
    flex-direction: row;
    justify-content: space-between;
}

.inventory__item .unity-button {
    background-color: transparent;
    border-color: rgb(0, 255, 0);
    
    transition-property: background-color, color;
    transition-duration: 0.2s;
}

.inventory__item .unity-button:hover {
    background-color: rgb(0, 255, 0);
    color: rgb(0, 0, 0);
}