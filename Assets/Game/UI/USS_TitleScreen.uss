#Background {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    
    background-color: #000;
    
    justify-content: space-around;
    align-items: center;
}

#Title {
    font-size: 48px;
    color: #0d0;
    -unity-text-align: middle-center;
}

#PlayButton {
    border-width: 2px;
    border-color: #0d0;
    border-radius: 4px;
    background-color: transparent;
    color: #0d0;
    width: 150px;
}
#PlayButton:hover {
    background-color: #0d0;
    color: #000;
}